# ==============================================================================
# TiqueTaque Sync - Configuration
# ==============================================================================
# This file is OPTIONAL and aimed at Docker/Kubernetes deployments.
#
# On a laptop, prefer `tiquetaque-sync setup` or the /settings screen: they write
# a per-user config.json (see `tiquetaque-sync config path`) and apply changes
# without a restart.
#
# Precedence, highest first:
#   environment variables > .env (this file) > config.json > defaults
# Anything set here therefore OVERRIDES what you save in the settings screen.
# ==============================================================================

# --- TiqueTaque Credentials ---
# Email and 4-digit SMS/App verification code used to log in on tiquetaque.app
TIQUETAQUE_EMAIL=seu-email@empresa.com.br
TIQUETAQUE_CODE=1234
# Optional: Set directly if you want to skip automatic code verification on startup
# TIQUETAQUE_TOKEN=eyJhbGciOiJIUzI1NiIsInR5c...
# TIQUETAQUE_EMPLOYEE_ID=600000000000000000000000
# TIQUETAQUE_FULL_NAME="Seu Nome Completo"

# --- Polling & Workday Settings ---
# Polling interval in seconds (default: 180s = 3 minutes)
POLL_INTERVAL_SECONDS=180
# Timezone for workday calculations
TIMEZONE=America/Sao_Paulo
# Daily target work duration in hours (default: 8.0)
WORK_HOURS_PER_DAY=8.0
# Standard minimum lunch duration in minutes (default: 60)
LUNCH_DURATION_MINUTES=60
# Advance warning for lunch end in minutes (default: 10)
LUNCH_WARNING_ADVANCE_MINUTES=10
# Final warning for lunch end in minutes (default: 1)
LUNCH_WARNING_FINAL_MINUTES=1
# Advance warning for end of shift in minutes (default: 15)
END_WORK_WARNING_ADVANCE_MINUTES=15
# Final warning for end of shift in minutes (default: 1)
END_WORK_WARNING_FINAL_MINUTES=1

# --- CLT Continuous Work Limits (Art. 71 CLT) ---
# Maximum continuous work hours without rest/lunch break (default: 6.0)
CONTINUOUS_WORK_LIMIT_HOURS=6.0
# Advance warning before reaching 6h continuous work (default: 10 min)
CONTINUOUS_WORK_WARNING_ADVANCE_MINUTES=10
# Final critical warning before reaching 6h continuous work (default: 1 min)
CONTINUOUS_WORK_WARNING_FINAL_MINUTES=1
# Local fast ticker interval for precise minute-by-minute alert evaluation (default: 15 seconds)
ALERT_TICKER_INTERVAL_SECONDS=15

# --- Telegram Notifications (Optional) ---
# Create a bot via @BotFather and obtain the token
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=123456789:SEU-TOKEN-DO-BOTFATHER
TELEGRAM_CHAT_ID=123456789

# --- Slack Notifications (Optional) ---
# Create an Incoming Webhook in your Slack workspace
SLACK_ENABLED=false
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/SEU-WORKSPACE-ID/SEU-CANAL-ID/SEU-TOKEN

# --- Server & Storage ---
# Desktop default is 127.0.0.1 (loopback only). Containers need 0.0.0.0.
HOST=0.0.0.0
PORT=8000
# Defaults to a per-user directory; containers should point it at the volume.
DATA_DIR=/app/data
# Open the dashboard in the browser when `tiquetaque-sync start` runs
OPEN_BROWSER_ON_START=true
# Overrides where config.json lives (useful for portable installs and containers)
# TIQUETAQUE_SYNC_HOME=/app/config
API_SECRET_KEY=generate_a_secure_random_key_here
